# ==============================================================================
# Nexus Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - Never commit .env.local or real secrets to version control.
# - Required variables must be configured for the application to function.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
# Optional: Local application URL used for redirects or metadata
# Where to obtain: Default local URL is http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Clerk Authentication
# ------------------------------------------------------------------------------
# Required: Publishable key from your Clerk application dashboard
# Where to obtain: Clerk Dashboard > API Keys > Publishable key (starts with pk_test_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# Required: Secret key for server-side Clerk API authentication
# Where to obtain: Clerk Dashboard > API Keys > Secret key (starts with sk_test_)
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Optional: Custom Clerk routing URLs (Clerk defaults to modal/component flows if unset)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------------------------
# 3. Convex Database & Real-Time Sync
# ------------------------------------------------------------------------------
# Required: Public URL for your Convex deployment (HTTP/WebSocket endpoint)
# Where to obtain: Generated automatically by `npx convex dev` or found in Convex Dashboard > Project Settings
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Required (Convex CLI / Cloud): Deployment identifier used by Convex CLI
# Where to obtain: Provided when creating a Convex project via `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name

# ------------------------------------------------------------------------------
# 4. Internal Service Shared Secret (NEXUS_CONVEX_INTERNAL_KEY)
# ------------------------------------------------------------------------------
# Required: Shared secret key for internal service-to-service communication
# Purpose: Authorizes backend API routes, Inngest background jobs, and Convex system mutations/queries
# How to generate: openssl rand -hex 32
# Matching Requirement: MUST be set in BOTH `.env.local` AND in Convex environment:
#   npx convex env set NEXUS_CONVEX_INTERNAL_KEY <your-32-byte-hex-secret>
# Security: NEVER prefix with NEXT_PUBLIC_ or expose to the browser!
NEXUS_CONVEX_INTERNAL_KEY=replace_with_secure_random_hex_string_32_bytes

# ------------------------------------------------------------------------------
# 5. Convex Auth (Clerk JWT Issuer Domain)
# ------------------------------------------------------------------------------
# Required in Convex Dashboard: The Issuer URL from your Clerk JWT template for Convex
# Where to obtain: Clerk Dashboard > JWT Templates > Convex > Issuer URL (e.g. https://<id>.clerk.accounts.dev)
# Configure in Convex via: npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<id>.clerk.accounts.dev
# (Optional in .env.local, but required in Convex deployment environment)
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer-domain.clerk.accounts.dev

# ------------------------------------------------------------------------------
# 6. Inngest Background Workflows
# ------------------------------------------------------------------------------
# Optional for local dev: Signing key for Inngest webhook verification (required for production/cloud)
# Where to obtain: Inngest Cloud Dashboard > Event Keys / Signing Keys
# INNGEST_SIGNING_KEY=signkey-test-...
# INNGEST_EVENT_KEY=...

# ------------------------------------------------------------------------------
# 7. AI Providers (OpenAI)
# ------------------------------------------------------------------------------
# Required: API key for OpenAI GPT models (used for code generation, chat, and quick-edit)
# Where to obtain: OpenAI Platform > API Keys > Create new secret key (starts with sk-proj-)
OPENAI_API_KEY=sk-proj-replace_with_your_openai_api_key

# ------------------------------------------------------------------------------
# 8. Web Scraping & Documentation Integration (Firecrawl)
# ------------------------------------------------------------------------------
# Optional: API key for Firecrawl web scraping in Cmd+K quick edit with URL documentation
# Where to obtain: Firecrawl Dashboard (https://www.firecrawl.dev) > API Keys
# If unset, quick-edit URL scraping is skipped or returns null
FIRECRAWL_API_KEY=fc-replace_with_your_firecrawl_api_key

# ------------------------------------------------------------------------------
# 9. Error Monitoring & Observability (Sentry)
# ------------------------------------------------------------------------------
# Optional Sentry configuration:
# Both settings are optional. Leaving a variable empty disables Sentry reporting for that runtime.
#
# Browser/client runtime: public DSN, included at build time in the client bundle.
NEXT_PUBLIC_SENTRY_DSN=
#
# Server and Edge runtimes: server-side DSN (must remain server-side).
SENTRY_DSN=
